# HydroSight AI - Meta AI API Configuration
# Copy this file to `.env` and fill in your own key. Never commit `.env`.

# Meta AI API key. Get one from your Meta AI developer / hackathon account.
# Without a key the backend still runs: SAM 3.1 / Muse Spark calls fall back
# to calibrated preset masks and gauges for the built-in Rodriguez scenarios.
# API responses say so via `fallback_used` and `execution_mode`.
META_API_KEY=

# Meta AI API base URL. Leave as the default unless Meta gives you another.
META_API_BASE_URL=https://api.meta.ai/v1

# Optional. Label shown in dispatch telemetry for the ticket-formatting step.
AGENT_DISPATCH_PROVIDER=Meta AI API

# Meta API response caching. 0 (default) = every request runs fresh against
# the live models, which is what you want for a demo. Set to 1 only for
# offline development against previously cached runs.
HYDROSIGHT_CACHE_ENABLED=0
